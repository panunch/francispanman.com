{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fp-www",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }

  // Session 0.3: attach www as a Custom Domain (dashboard, or uncomment):
